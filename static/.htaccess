<IfModule mod_headers.c>
    # Header CORS dan streaming partial content (Byte-Range) untuk audio
    <FilesMatch "\.(mp3|mp4|ogg|wav|m4a)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Accept-Ranges "bytes"
    </FilesMatch>
</IfModule>

# MIME Types untuk file audio
AddType audio/mpeg .mp3
AddType audio/ogg .ogg
AddType audio/wav .wav
AddType audio/mp4 .m4a

# Izin akses kompatibel untuk Apache 2.2 dan Apache 2.4 (Shared Hosting / cPanel)
<FilesMatch "\.(mp3|mp4|ogg|wav|m4a)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Routing SPA SvelteKit
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Jangan redirect jika file atau folder fisik memang ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Jangan rewrite file asset / media ke index.html agar tidak corrupt format
    RewriteCond %{REQUEST_URI} \.(mp3|mp4|ogg|wav|m4a|png|jpg|jpeg|gif|webp|svg|css|js|woff|woff2)$ [NC]
    RewriteRule ^ - [R=404,L]

    # Fallback ke index.html untuk route SPA
    RewriteRule . index.html [L]
</IfModule>